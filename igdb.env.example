# Copy to ~/.config/game-catalog/igdb.env and chmod 600 it.
# IGDB uses Twitch accounts: register an application at
# https://dev.twitch.tv/console/apps (OAuth redirect URL: http://localhost,
# category: Application Integration), then copy its Client ID and make a
# new Client Secret. Details: https://api-docs.igdb.com/#account-creation
IGDB_CLIENT_ID=paste_your_client_id_here
IGDB_CLIENT_SECRET=paste_your_client_secret_here
